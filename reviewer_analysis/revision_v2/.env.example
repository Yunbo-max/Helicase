# Copy to reviewer_analysis/revision_v2/private/.env. NEVER commit real keys.
# Original native pipeline: SiliconFlow, not a generic "Qwen key".
SILICONFLOW_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=

# Historical model identifiers read from the uploaded source. Availability is NOT
# guaranteed: confirm these exact models in your provider account before a pilot.
SILICON_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
CODING_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
# Set all helper roles explicitly to freeze the experiment. Changing a model is a
# NEW configuration; do not combine it with earlier runs as an identical replicate.
READER_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
PREFILTER_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
QUERY_VARIANT_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
UQ_SUMMARIZER_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
UQ_CONSENSUS_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
SEARCH_ENGINE=serper
WEB_SEARCH_MIN_PARALLEL_QUERIES=1
WEB_SEARCH_MAX_PARALLEL_QUERIES=10
NEO4J_ENABLED=false

# Separate evaluator. Choose an available final-JSON-capable model explicitly.
# This key may be the same SiliconFlow account key, but an alternative judge
# must use a genuinely different model (preferably another model family).
REVIEW_JUDGE_BASE_URL=https://api.siliconflow.cn/v1
REVIEW_JUDGE_MODEL=
REVIEW_JUDGE_KEY_ENV=SILICONFLOW_API_KEY
REVIEW_JUDGE_MAX_TOKENS=2048
REVIEW_JUDGE_EXTRA_JSON={}
# Alibaba alternative: set its region-specific compatible endpoint and model,
# REVIEW_JUDGE_KEY_ENV=DASHSCOPE_API_KEY, and fill that provider's key below.
DASHSCOPE_API_KEY=
